{
  "name": "shipbench-radar",
  "private": true,
  "type": "module",
  "description": "Several ShipBench boards in one window, one tab per repository. Personal tool; not published.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "node --watch src/server/main.ts --dev",
    "dev:web": "vite",
    "build": "vite build",
    "start": "vite build && node src/server/main.ts",
    "radar": "node src/cli/radar.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/web/tsconfig.json",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/intel-one-mono": "^5.3.0",
    "@shipbench/board": "0.4.0",
    "@shipbench/core": "0.4.0",
    "chokidar": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "4.1.9"
  }
}
